	set terminal svg ;	set output "times.svg" ;	set xlabel "number of threads" ;	set ylabel "real time (s)" ;	a=1; b=10;	f(x)=a+b/x;	T0=0.25; s=0.05;	f2(x)=T0*(s + (1-s)/x) ;	fit f(x) "out.times" using 1:2 via a,b ;	fit f2(x) "out.times" using 1:2 via T0,s ;	plot 		"out.times" using 1:2 with linespoints title "times", 		f(x)  with lines lw 3 lc rgb "blue"  title "fit: a+b/n", 	    f2(x) with lines lw 3 dt 2 lc rgb "red" title "fit: Amdahl" ;
